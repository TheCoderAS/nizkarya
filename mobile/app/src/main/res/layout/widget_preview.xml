<!--
  Shown in the widget picker and for the instant before Glance draws. Glance
  builds the real content in Kotlin, so this only has to look like the thing
  rather than be it. It carries the same ground and the same violet edge, so
  the swap when the real content arrives is not a jump.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">
    <View
        android:layout_width="3dp"
        android:layout_height="22dp"
        android:background="@drawable/widget_bar_task" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="@string/app_name"
        android:textColor="#F3F3F8"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
