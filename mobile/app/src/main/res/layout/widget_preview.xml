<!--
  Shown in the widget picker and for the instant before Glance draws. Glance
  builds the real content in Kotlin, so this only has to look like the thing
  rather than be it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface"
    android:gravity="center"
    android:orientation="vertical">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#F3F3F8"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
