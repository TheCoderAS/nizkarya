<!--
  One item's card, the widget's version of a timeline block in the app.

  The gap between rows is an inset on the drawable rather than a wrapper view
  around the row. A background covers a view's padding, so the only other way
  to get air between two cards is another layout around each one, and the row
  is one of the few places in this app where an extra layer actually costs
  something: it is inside a collection, redrawn per item.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetBottom="6dp">
    <shape android:shape="rectangle">
        <solid android:color="#14FFFFFF" />
        <corners android:radius="14dp" />
    </shape>
</inset>
