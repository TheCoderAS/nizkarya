<!--
  The widget's own ground.

  Widgets sit on the wallpaper rather than on the app's canvas, so this commits
  to the dark surface in both themes: a translucent light card over a dark
  wallpaper is unreadable, and the app's near-black already reads as deliberate
  on anything.

  The violet lean and the hairline edge are the same two moves the app's cards
  make. Drawn as a shape rather than a corner modifier because Glance's
  cornerRadius only exists from API 31 and minSdk here is 26.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:type="linear"
        android:startColor="#FA171526"
        android:centerColor="#FA141320"
        android:endColor="#FA101018" />
    <corners android:radius="24dp" />
    <stroke android:width="1dp" android:color="#1FFFFFFF" />
</shape>
