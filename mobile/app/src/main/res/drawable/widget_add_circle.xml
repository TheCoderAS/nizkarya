<!--
  The add button's fill. This is the app's CTA gradient, flattened into two
  stops because RemoteViews cannot take a Brush. It is a solid control now
  rather than an eighteen percent tint, so it reads as the one thing on the
  widget you press to make something new.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:angle="135"
        android:type="linear"
        android:startColor="#8B7CF6"
        android:endColor="#5B49E0" />
</shape>
